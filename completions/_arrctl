#compdef arrctl

_arrctl() {
  local context state line
  typeset -A opt_args

  local -a top_commands
  top_commands=(
    'sonarr:Manage Sonarr (TV shows)'
    'radarr:Manage Radarr (Movies)'
    'overseerr:Manage Overseerr (Requests)'
    'tautulli:View Plex activity'
    'calendar:Show upcoming releases'
    'completion:Manage shell completions'
    'update:Update arrctl'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version]' \
    '--config=[Use config file]:file:_files' \
    '1:command:->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'arrctl command' top_commands
      return
      ;;
    args)
      case "$line[1]" in
        sonarr)
          _arrctl_sonarr
          ;;
        radarr)
          _arrctl_radarr
          ;;
        overseerr)
          _arrctl_overseerr
          ;;
        tautulli)
          _arrctl_tautulli
          ;;
        calendar)
          _arrctl_calendar
          ;;
        completion)
          _arrctl_completion
          ;;
      esac
      ;;
  esac
}

_arrctl_sonarr() {
  local -a subcmds
  subcmds=(
    'list:List all series'
    'search:Search for series'
    'add:Add a series'
    'calendar:Show upcoming episodes'
    'help:Show help'
  )

  _arguments -C \
    '1:command:->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'sonarr command' subcmds
      ;;
    args)
      case $words[1] in
        list)
          _arguments \
            '--monitored[Only monitored series]' \
            '--format=[Output format]:format:(json table auto)' \
            '(-q --quiet)'{-q,--quiet}'[Quiet mode]' \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        search)
          _arguments \
            '--limit=[Limit results]:count:' \
            '--format=[Output format]:format:(json table auto)' \
            '(-h --help)'{-h,--help}'[Show help]' \
            '*:search term:'
          ;;
        add)
          _arguments \
            '--id=[TVDB ID]:id:' \
            '--quality=[Quality profile]:profile:' \
            '--root=[Root folder path]:path:_files -/' \
            '--search[Search after add]' \
            '--monitored[Monitor series]' \
            '--no-monitored[Do not monitor series]' \
            '--format=[Output format]:format:(json table auto)' \
            '(-q --quiet)'{-q,--quiet}'[Quiet mode]' \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        calendar)
          _arguments \
            '--days=[Show next N days]:days:' \
            '--start=[Start date YYYY-MM-DD]:date:' \
            '--end=[End date YYYY-MM-DD]:date:' \
            '--format=[Output format]:format:(json table auto)' \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        help)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
      esac
      ;;
  esac
}

