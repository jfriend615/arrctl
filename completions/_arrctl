    '--days=[Show next N days]:days:' \
    '--week[Show current week]' \
    '--sonarr[Show TV episodes only]' \
    '--radarr[Show movies only]' \
    '--format=[Output format]:format:(json table auto)' \
    '(-h --help)'{-h,--help}'[Show help]'
