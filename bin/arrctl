#!/bin/sh
# arrctl - Unified CLI for managing *arr services
# POSIX compliant - tested with dash

set -e

# Resolve script directory (works with symlinks)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"

# Source common utilities
# shellcheck source=lib/common.sh
# shellcheck disable=SC1091
. "${LIB_DIR}/common.sh"

VERSION="0.1.0"

show_version() {
    printf "arrctl version %s\n" "$VERSION"
}

show_help() {
    cat <<EOF
arrctl - Unified CLI for managing *arr services

Usage: arrctl <command> [options]

Commands:
    sonarr      Manage Sonarr (TV shows)
    radarr      Manage Radarr (Movies)
    overseerr   Manage Overseerr (Requests)
    tautulli    View Plex activity (who is streaming)

Options:
    -h, --help      Show this help message
    -v, --version   Show version information
    --config FILE   Use specified config file

Configuration:
    Default config: ~/.config/arrctl/config.json
    Or set environment variables:
        ARRCTL_CONFIG      Path to config file
        SONARR_URL         Sonarr API URL
        SONARR_API_KEY     Sonarr API key
        RADARR_URL         Radarr API URL
        RADARR_API_KEY     Radarr API key
        OVERSEERR_URL      Overseerr API URL
        OVERSEERR_API_KEY  Overseerr API key
        TAUTULLI_URL       Tautulli API URL
        TAUTULLI_API_KEY   Tautulli API key

Examples:
    arrctl sonarr list
    arrctl sonarr search "Breaking Bad"
    arrctl radarr list --monitored
    arrctl radarr search "The Matrix"
    arrctl radarr add --id 603 --search
    arrctl overseerr pending
    arrctl tautulli now

EOF
}

# Main command dispatcher
main() {
    # Handle no arguments
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        sonarr|radarr|overseerr|tautulli)
            SERVICE="$1"
            shift
            # Service-specific handlers will be added in future tickets
            if [ -f "${LIB_DIR}/${SERVICE}.sh" ]; then
                # shellcheck disable=SC1090
                . "${LIB_DIR}/${SERVICE}.sh"
                "${SERVICE}_main" "$@"
            else
                printf "Service '%s' is not yet implemented.\n" "$SERVICE" >&2
                exit 1
            fi
            ;;
        *)
            die "Unknown command: $1. Use --help for usage."
            ;;
    esac
}

main "$@"
